Enum user_role {
  MANAGER
  OPERATOR
  QUALITY
}

Enum work_order_status {
  PLANNED
  IN_PROGRESS
  CLOSED
}

Enum measurement_result {
  PASS
  FAIL
}

Enum ai_summary_status {
  SUCCESS
  FAILED
}

Table users {
  id bigint [pk, increment]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  name varchar(50) [not null]
  role user_role [not null]
}

Table products {
  id bigint [pk, increment]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
}

Table equipment {
  id bigint [pk, increment]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
}

Table inspection_specs {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  feature_name varchar(100) [not null]
  target_value decimal(10,3) [not null]
  lower_limit decimal(10,3) [not null]
  upper_limit decimal(10,3) [not null]
  unit varchar(10) [not null]
  version varchar(20) [not null]

  indexes { (product_id, version) [unique] }
}

Table work_orders {
  id bigint [pk, increment]
  order_no varchar(30) [not null, unique]
  product_id bigint [not null, ref: > products.id]
  target_qty int [not null, note: '양의 정수']
  due_date date [not null]
  status work_order_status [not null, default: 'PLANNED']
  created_by bigint [not null, ref: > users.id]
  created_at timestamp [not null]
  started_by bigint [ref: > users.id]
  started_at timestamp
  closed_by bigint [ref: > users.id]
  closed_at timestamp
  close_reason varchar(500)
}

// 누적 생산량은 중복 저장하지 않고, 연결된 production_lots.produced_qty의 합계로 계산한다.

Table production_lots {
  id bigint [pk, increment]
  lot_no varchar(30) [not null, unique]
  work_order_id bigint [not null, ref: > work_orders.id]
  equipment_id bigint [not null, ref: > equipment.id]
  spec_id bigint [not null, ref: > inspection_specs.id]
  produced_qty int [not null, note: '양의 정수, 같은 작업지시의 누적 수량은 목표 이하']
  started_at timestamp [not null]
  ended_at timestamp [not null, note: 'started_at보다 늦어야 함']
  operator_id bigint [not null, ref: > users.id]
  production_note text
  created_at timestamp [not null]

  // --- 신규 추가: 와이어프레임의 '이상징후 등록' 기능 반영 ---
  anomaly_type varchar(50) [note: '예: 소음. 이상징후 없으면 null']
  anomaly_detected_at timestamp [note: '이상징후 없으면 null']
  anomaly_note text [note: '작업자 관찰 내용. 이상징후 없으면 null']
}

Table inspections {
  id bigint [pk, increment]
  lot_id bigint [not null, unique, ref: > production_lots.id]
  inspector_id bigint [not null, ref: > users.id]
  inspected_at timestamp [not null]
  inspection_note text
}

Table measurements {
  id bigint [pk, increment]
  inspection_id bigint [not null, ref: > inspections.id]
  item_no int [not null]
  measured_value decimal(10,3) [not null]
  result measurement_result [not null, note: '서버가 규격으로 판정']

  indexes { (inspection_id, item_no) [unique] }
}

Table ai_summaries {
  id bigint [pk, increment]
  lot_id bigint [not null, ref: > production_lots.id]
  status ai_summary_status [not null, note: '신규 추가 - 실패 이력도 이 테이블에 저장']
  summary_text text [note: '신규: status=FAILED면 null 허용하도록 not null 제거']
  model varchar(50) [note: '신규: 사용한 AI 모델명']
  created_by bigint [not null, ref: > users.id]
  created_at timestamp [not null]
}

// --- 신규 테이블: F08(요약 검토본 저장) 구현을 위해 추가 ---
Table summary_reviews {
  id bigint [pk, increment]
  summary_id bigint [not null, ref: > ai_summaries.id]
  reviewed_text text [not null]
  reviewer_id bigint [not null, ref: > users.id]
  reviewed_at timestamp [not null]
}

// --- 신규 테이블: AI 요약 생성 시 선택한 관련 LOT을 재현 가능하게 저장 ---
// (관련 LOT 조회 자체는 저장 없이 매번 계산하지만, "이 요약이 어떤 LOT을 근거로 했는지"는
//  감사·재검토를 위해 고정해 둬야 하므로 요약 생성 시점에 스냅샷으로 저장한다)
Table ai_summary_related_lots {
  id bigint [pk, increment]
  summary_id bigint [not null, ref: > ai_summaries.id]
  related_lot_id bigint [not null, ref: > production_lots.id]

  indexes { (summary_id, related_lot_id) [unique] }
}
