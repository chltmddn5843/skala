#!/bin/bash

alias kcns='kubectl config set-context $(kubectl config current-context) --namespace'
alias all-resources='kubectl api-resources --verbs=list --namespaced -o name | xargs -n 1 kubectl get --show-kind --ignore-not-found'
alias k='kubectl'

export DOCKER_REGISTRY="skala-registry.skala-ai.com"
export DOCKER_REGISTRY_USER="robot\$skala26b"
export DOCKER_REGISTRY_PASSWORD="oiPrruKtwhievCN1jFOLeZtl3Ge71EcD"
export PATH="$HOME/.kube:$PATH"

export INGRESS_CLASS_NAME="public-nginx"
export LOCATION="pg"
