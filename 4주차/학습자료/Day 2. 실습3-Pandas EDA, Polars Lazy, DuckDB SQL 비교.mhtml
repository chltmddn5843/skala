def calculate_iqr_bounds(amount: pd.Series) -&gt; tuple[float, float, float=
, float, float]:
    """Q1, Q3, IQR, =ED=95=98=ED=95=9C=EA=B0=92, =EC=83=81=ED=95=9C=EA=B0=
=92=EC=9D=84 =EA=B3=84=EC=82=B0=ED=95=A9=EB=8B=88=EB=8B=A4."""
    q1 =3D float(amount.quantile(0.25))
    q3 =3D float(amount.quantile(0.75))
    iqr =3D q3 - q1
    if iqr =3D=3D 0:
        raise ValueError("IQR=EC=9D=B4 0=EC=9D=B4=EB=AF=80=EB=A1=9C amount =
=EB=B6=84=ED=8F=AC=EB=A5=BC =ED=99=95=EC=9D=B8=ED=95=98=EC=84=B8=EC=9A=94."=
)
    lower =3D q1 - 1.5 * iqr
    upper =3D q3 + 1.5 * iqr
    return q1, q3, iqr, lower, upper


