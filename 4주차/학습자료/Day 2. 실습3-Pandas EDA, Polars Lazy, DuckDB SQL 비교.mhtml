def polars_aggregation(file_path: Path, lower: float, upper: float) -&gt; p=
d.DataFrame:
    """scan_csv=EC=97=90=EC=84=9C collect=EA=B9=8C=EC=A7=80 Polars Lazy =EC=
=B2=B4=EC=9D=B8=EC=9C=BC=EB=A1=9C =EC=A7=91=EA=B3=84=ED=95=A9=EB=8B=88=EB=
=8B=A4."""
    result =3D (
        pl.scan_csv(
            str(file_path),
            schema_overrides=3D{
                "region": pl.String,
                "category": pl.String,
                "amount": pl.String,
            },
        )
        .with_columns(
            pl.col("region").str.strip_chars(),
            pl.col("category").str.strip_chars(),
            pl.col("amount").cast(pl.Float64, strict=3DFalse),
        )
        .filter(
            pl.col("region").is_not_null()
            &amp; pl.col("category").is_not_null()
            &amp; (pl.col("region") !=3D "")
            &amp; (pl.col("category") !=3D "")
            &amp; pl.col("amount").is_not_null()
            &amp; (pl.col("amount") &gt;=3D lower)
            &amp; (pl.col("amount") &lt;=3D upper)
        )
        .group_by(["region", "category"])
        .agg(
            pl.col("amount").sum().alias("total"),
            pl.col("amount").mean().alias("mean"),
            pl.len().alias("count"),
        )
        .sort(["total", "region", "category"], descending=3D[True, False, F=
alse])
        .collect()
    )
    return pd.DataFrame(result.to_dicts(), columns=3DRESULT_COLUMNS)


def duckdb_aggregation(file_path: Path, lower: float, upper: float) -&gt; p=
d.DataFrame:
    """DuckDB=EC=97=90=EC=84=9C CSV =ED=8C=8C=EC=9D=BC=EC=9D=84 =EC=A7=81=
=EC=A0=91 =EC=9D=BD=EC=96=B4 SQL=EB=A1=9C =EC=A7=91=EA=B3=84=ED=95=A9=EB=8B=
=88=EB=8B=A4."""
    sql_path =3D str(file_path).replace("\\", "/").replace("'", "''")
    query =3D f"""
        WITH cleaned AS (
            SELECT
                TRIM(region) AS region,
                TRIM(category) AS category,
                TRY_CAST(amount AS DOUBLE) AS amount
            FROM read_csv('{sql_path}', header =3D true, all_varchar =3D tr=
ue)
        )
        SELECT
            region,
            category,
            SUM(amount) AS total,
            AVG(amount) AS mean,
            COUNT(amount) AS count
        FROM cleaned
        WHERE region IS NOT NULL
          AND category IS NOT NULL
          AND region &lt;&gt; ''
          AND category &lt;&gt; ''
          AND amount IS NOT NULL
          AND amount BETWEEN ? AND ?
        GROUP BY region, category
        ORDER BY total DESC, region ASC, category ASC
    """
    with duckdb.connect(database=3D":memory:") as connection:
        return connection.execute(query, [lower, upper]).df()


def normalize_result(dataframe: pd.DataFrame) -&gt; pd.DataFrame:
    """=EC=84=B8 =EA=B2=B0=EA=B3=BC=EC=9D=98 =EC=BB=AC=EB=9F=BC, =EC=9E=90=
=EB=A3=8C=ED=98=95, =EC=A0=95=EB=A0=AC=EC=9D=84 =EB=B9=84=EA=B5=90 =EA=B0=
