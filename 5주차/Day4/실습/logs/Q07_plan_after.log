Q07 재고 부족 위험 상품 [after]

PERFORMANCE SQL
EXPLAIN (ANALYZE, BUFFERS)
SELECT
            p.product_id,
            p.product_name,
            i.qty_on_hand,
            i.reorder_point,
            i.reorder_point - i.qty_on_hand AS shortage
        FROM ecom.inventory i
        JOIN ecom.products p
          ON p.product_id = i.product_id
        WHERE i.qty_on_hand < i.reorder_point
        ORDER BY
            shortage DESC,
            p.product_id

