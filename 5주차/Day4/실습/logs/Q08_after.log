Q08 리뷰 기반 효자상품 [after]

SQL
WITH review_summary AS (
            SELECT
                product_id,
                avg(rating) AS avg_rating,
                count(*) AS review_count
            FROM ecom.reviews
            GROUP BY product_id
            HAVING avg(rating) >= 4.5
               AND count(*) >= 50
        )

        SELECT
            rs.product_id,
            p.product_name,
            rs.avg_rating,
            rs.review_count
        FROM review_summary rs
        JOIN ecom.products p
          ON p.product_id = rs.product_id
        ORDER BY
            rs.avg_rating DESC,
            rs.review_count DESC,
            rs.product_id

