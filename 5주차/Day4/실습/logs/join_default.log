SELECT o.customer_id, count(*) AS item_count, sum(oi.line_total) AS revenue
    FROM ecom.orders o JOIN ecom.order_items oi USING (order_id)
    WHERE o.order_status IN ('paid','shipped','delivered')
    GROUP BY o.customer_id

